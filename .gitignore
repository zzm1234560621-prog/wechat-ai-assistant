# ---- 虚拟环境与缓存 ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- 本地敏感配置：含真实 API key / wxid，勿提交 ----
config.yaml
settings.json
.claude/settings.local.json

# ---- 运行期数据 ----
data/
*.log

# ---- 安装脚本的运行日志：每次跑都重写，而且里面带本机用户名和绝对路径
# （`C:\Users\<你>\...` / 项目所在盘符），是私人信息，别提交 ----
installers/*-log.txt
installers/**/*-log.txt

# ---- 自测用的图片（从微信缓存里拷的，是私人内容，别提交）----
test_images/

# ---- 审计用的真机语音样本（从微信进程内存里捞出来的真人语音，勿提交）----
_audit/

# ---- 配置的备份副本（里面是真的 API key / wxid / 人设，勿提交）----
settings.json.bak*

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
Thumbs.db
desktop.ini
